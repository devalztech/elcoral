# Not needed for local dev — Vite's dev server proxies /api to localhost:8000
# (see vite.config.js). Only needed for production builds where the frontend
# and backend are different hosts (e.g. Render + Pterodactyl).
#
# Set this in Render's environment variables, pointing at your backend's
# public URL, no trailing slash:
VITE_API_URL=https://your-backend-url.example.com
