
# --- Admin / management console -------------------------------------------
# Origin(s) of the separately-hosted management app (comma-separated).
ADMIN_CORS_ORIGINS=http://localhost:5174
# Public URL of the management app, no trailing slash.
ADMIN_URL=
# Admin sessions are short: the console can delete accounts.
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60
# First-run only: grants superadmin to this EXISTING account on startup.
# Unset it once the first superadmin exists.
BOOTSTRAP_SUPERADMIN_EMAIL=
